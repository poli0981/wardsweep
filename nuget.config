<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    One source only. The vulnerability scan in dotnet-ci.yml is a hard gate, and
    it is only meaningful if every package came from somewhere it can report on.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
