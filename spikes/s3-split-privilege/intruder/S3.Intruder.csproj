<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The third process. Built into the same output directory as S3.Ui.exe so it
    passes the broker's directory check and fails only on the file name — which
    is the interesting half. A binary sitting somewhere else would be refused
    for the easy reason and prove less.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>S3.Intruder</AssemblyName>
    <RootNamespace>S3.Intruder</RootNamespace>
  </PropertyGroup>

</Project>
